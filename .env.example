# Resume Scorer — environment variables
# Copy this file to `.env` and fill in your own values.
# `.env` should never be committed — make sure it's listed in .gitignore.

# ---- LLM provider API keys ----
# utils/model_loader.py currently requires BOTH keys to be present at
# startup, even though only one provider is used at a time (see
# LLM_PROVIDER below). Get a free key from each provider's console:
#   Google Gemini: https://aistudio.google.com/
#   Groq:          https://console.groq.com/
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ---- Provider selection ----
# Which block in config/config.yaml to use ("google" or "groq").
# Defaults to "google" if not set.
LLM_PROVIDER=google

# ---- Optional: resume storage location ----
# Where uploaded resumes are saved (per-session subfolders are created
# automatically). Defaults to "<project_root>/data/resume_analysis" if
# not set.
# DATA_STORAGE_PATH=data/resume_analysis